// Cloudflare Workers config: the site is served as static assets with a small
// Worker in front (src/worker.js) that picks the story and sends a 503.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "static-brb",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    // The repository root, minus what .assetsignore leaves out.
    "directory": ".",
    "binding": "ASSETS",
    // Every request goes through the Worker, so every path gets the story.
    "run_worker_first": true,
    // Serve /el-nino.html as /el-nino.html, no redirects to /el-nino.
    "html_handling": "none"
  },
  "vars": {
    // Which page every path shows: el-nino, migration or brb-pbs (EL_NINO,
    // BRB and other spellings are forgiven). Change it here and redeploy, or override
    // it in the dashboard under the Worker's Settings, Variables.
    "STORY": "el-nino"
  },
  // Worker Previews (branch builds, `npx wrangler preview`) need this block,
  // even empty. Previews don't inherit production vars, so they show the
  // Worker's default story, el-nino, unless STORY is set here too.
  "previews": {},
  "observability": {
    "enabled": true
  }
}
